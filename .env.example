# ===== 密钥 =====
# 只放密钥。base_url / model 不在这里，在 providers.toml 里。
# 想加后端就去改 providers.toml，然后在这里补它需要的 key。
SILICONFLOW_API_KEY=sk-你的密钥

# 本服务对外提供的调用密钥：客户端必须在请求头 X-API-Key 里带上它
# 生成一个随机值：python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=换成一串足够长的随机字符

# ===== 模型调用超时（秒）=====
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=15
LLM_MAX_ATTEMPTS=3
